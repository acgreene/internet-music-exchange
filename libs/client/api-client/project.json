{
  "name": "api-client",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/client/api-client/src",
  "prefix": "ime",
  "projectType": "library",
  "tags": ["scope:client", "type:data-access"],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "dependsOn": [
        {
          "projects": ["client-env"],
          "target": "generate-env"
        }
      ]
    },
    "test": {
      "dependsOn": [
        {
          "projects": ["client-env"],
          "target": "generate-env"
        }
      ]
    },
    "typecheck": {
      "dependsOn": [
        {
          "projects": ["client-env"],
          "target": "generate-env"
        }
      ],
      "options": {
        "commands": [
          "tsc --noEmit -p tsconfig.lib.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ]
      }
    }
  }
}
