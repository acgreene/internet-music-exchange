{
  "name": "api-client",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/client/api-client/src",
  "prefix": "ime",
  "projectType": "library",
  "tags": ["scope:client", "type:data-access"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": [{ "projects": ["client-env"], "target": "generate-env" }]
    },
    "test": {
      "dependsOn": [{ "projects": ["client-env"], "target": "generate-env" }]
    },
    "typecheck": {
      "dependsOn": [{ "projects": ["client-env"], "target": "generate-env" }],
      "options": {
        "commands": [
          "tsc --noEmit -p tsconfig.lib.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ]
      }
    }
  }
}
