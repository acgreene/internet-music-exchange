# Local development (supabase start; keys shown by `supabase status`)
#
# SUPABASE_URL and SUPABASE_ANON_KEY are baked into the client bundles at build
# time by tools/generate-client-env.mjs, so both ship to browsers. Keep them
# publishable. SUPABASE_SERVICE_ROLE_KEY and DATABASE_URL are API-only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_ANON_KEY=<your-local-anon-key-from-supabase-status>
SUPABASE_SERVICE_ROLE_KEY=<your-local-service-role-key-from-supabase-status>

# Hosted Supabase. Fill these from the dashboard when targeting the hosted
# project instead of the local stack:
#   DATABASE_URL: Settings > Database > Connection string (transaction pooler,
#     port 6543), e.g. postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY: Settings > API
#     (the service role key is server-only; never expose it to clients)
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
