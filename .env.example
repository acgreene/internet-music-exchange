# Local development (supabase start; keys shown by `supabase status`)
#
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are baked into the client bundles
# at build time by tools/generate-client-env.mjs, so both ship to browsers.
# Keep them publishable. SUPABASE_SECRET_KEY and DATABASE_URL are API-only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_PUBLISHABLE_KEY=<your-local-publishable-key-from-supabase-status>
SUPABASE_SECRET_KEY=<your-local-secret-key-from-supabase-status>

# Cloudflare R2 (S3-compatible object storage). Create a bucket and an R2 API
# token (S3 auth) in the Cloudflare dashboard, then fill these:
#   R2_ENDPOINT: https://<account-id>.r2.cloudflarestorage.com
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: from the R2 API token
#   R2_BUCKET: the bucket name (e.g. ime-designer-pages-dev)
R2_ENDPOINT=<https://your-account-id.r2.cloudflarestorage.com>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET=<your-r2-bucket-name>

# Stripe, in test mode while developing (Dashboard > Developers):
#   STRIPE_SECRET_KEY: API keys > Secret key (sk_test_...)
#   STRIPE_WEBHOOK_SECRET: the signing secret for the platform's own events
#     (top-ups, donations), from a webhook endpoint on your account or the one
#     `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints
#   STRIPE_CONNECT_WEBHOOK_SECRET: the signing secret for connected accounts'
#     events, from a "Connected accounts" endpoint or the one `stripe listen
#     --forward-connect-to localhost:3000/api/webhooks/stripe/connect` prints
STRIPE_SECRET_KEY=<your-stripe-test-secret-key>
STRIPE_WEBHOOK_SECRET=<your-platform-webhook-signing-secret>
STRIPE_CONNECT_WEBHOOK_SECRET=<your-connect-webhook-signing-secret>

# Email through Resend (resend.com > API Keys). Leave the key out while
# developing and emails are written to the log instead. EMAIL_FROM must use a
# domain verified in Resend; onboarding@resend.dev only reaches your own inbox.
# RESEND_API_KEY=re_...
# EMAIL_FROM=IME <hello@your-domain>

# The web app, so links from Stripe and emails lead back to it.
WEB_APP_URL=http://localhost:4200

# Extra hostnames the web app's SSR server answers to, comma separated.
# Angular refuses requests for any other host. Production builds already allow
# internetmusicexchange.com and www.internetmusicexchange.com (apps/web
# project.json), and `nx serve web` needs nothing. Running the built server
# locally needs localhost; the server does not read this file by itself, so
# start it with `node --env-file=.env dist/apps/web/server/server.mjs`.
NG_ALLOWED_HOSTS=localhost

# Hosted Supabase. Fill these from the dashboard when targeting the hosted
# project instead of the local stack:
#   DATABASE_URL: Settings > Database > Connection string (transaction pooler,
#     port 6543), e.g. postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres
#   SUPABASE_URL: Settings > Data API; the keys: Settings > API Keys
#     (the secret key is server-only; never expose it to clients)
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
